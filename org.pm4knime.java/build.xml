<project xmlns:ivy="antlib:org.apache.ivy.ant" name="prom-wrapper" default="main">
	<property name="ivy.home" value="${user.home}\.ivy2" />

	<!-- ivy configuration to use everywhere -->
	<property name="ivy.conf" value="default"/>
	<property name="frontend.dir" value="${basedir}\js-src" />
	<property name="frontend.lock" value="${frontend.dir}\package-lock.json" />
	<available file="${frontend.lock}" property="frontend.has.lock" />
	<property environment="env" />
	<available file="C:\Program Files\nodejs\npm.cmd" property="npm.exec.path.programfiles" />
	<available file="C:\Program Files (x86)\nodejs\npm.cmd" property="npm.exec.path.programfilesx86" />

	<condition property="npm.exec" value="${env.NPM_EXEC}">
		<isset property="env.NPM_EXEC" />
	</condition>
	<condition property="npm.exec" value="C:\Program Files\nodejs\npm.cmd">
		<and>
			<isset property="npm.exec.path.programfiles" />
			<not><isset property="npm.exec" /></not>
		</and>
	</condition>
	<condition property="npm.exec" value="C:\Program Files (x86)\nodejs\npm.cmd">
		<and>
			<isset property="npm.exec.path.programfilesx86" />
			<not><isset property="npm.exec" /></not>
		</and>
	</condition>
	<condition property="npm.exec" value="npm.cmd">
		<and>
			<os family="windows" />
			<not><isset property="npm.exec" /></not>
		</and>
	</condition>
	<condition property="npm.exec" value="npm">
		<not><isset property="npm.exec" /></not>
	</condition>

	<!--  we could also store the values from lib into another folder
	1. get working space directory
	2. to get the pm4knime-maven directory
	3. set the library  -->
	<property name="lib.dir" value="reg-lib" />	
	
	<!-- Rebuild any jar matching a pattern, excluding given paths.
	     Core Ant only: assumes pattern matches exactly one jar. -->
	<macrodef name="strip-jar">
	    <attribute name="jarIncludes"/>
	    <attribute name="excludes"/>

	    <sequential>

	        <!-- make these properties local to each macro call -->
	        <local name="stripjar.jar"/>
	        <local name="stripjar.tmp"/>

	        <!-- find jar -->
	        <path id="stripjar.path">
	            <fileset dir="${plugin.lib.dir}" includes="@{jarIncludes}"/>
	        </path>

	        <pathconvert property="stripjar.jar" refid="stripjar.path"/>

	        <echo message="Stripping jar: ${stripjar.jar}"/>

	        <!-- rebuild jar without excluded entries -->
	        <tempfile property="stripjar.tmp" prefix="stripjar-" suffix=".jar" destdir="${java.io.tmpdir}"/>

	        <zip destfile="${stripjar.tmp}">
	            <zipfileset src="${stripjar.jar}" excludes="@{excludes}"/>
	        </zip>

	        <move file="${stripjar.tmp}" tofile="${stripjar.jar}" overwrite="true"/>

	    </sequential>
	</macrodef>

	
	<target name="lib-retrieve" description="retrieve jars only from prom, prom-libs">
		<ivy:retrieve pattern="reg-lib/[artifact]-[revision].[ext]">
			<mapper>
				<chainedmapper>
					<regexpmapper from="prom\\(.*)" to="\1" />
					<regexpmapper from="prom-libs\\(.*)" to="\1" />
				</chainedmapper>
			</mapper>
		</ivy:retrieve>
	</target>

 
	<target name="lib-resolve" description="resolve jars only from the specific organization">
		<ivy:settings file="ivysettings.xml" />
		<ivy:resolve file="${lib.project.dir}\ivy.xml" conf="${ivy.conf}" />
	</target>

	<target name="print">
		<echo>Second try for ${ivy.home}</echo>
		<echo>the current lib project dir is ${lib.project.dir}</echo>
		<echo>the current project dir is ${project.dir}</echo>
		<echo>the current project dir is ${plugin.lib.dir}</echo>
	</target>

	<target name="set" description="set the basic requirement for the task">
		<dirname file="${lib.dir}" property="lib.project.dir"/>
		<dirname file="${lib.project.dir}" property="project.dir"/>
		<property name="plugin.lib.dir" value="${plugin.project.dir}\..\lib"/>
		
		<dirname property="dirPro" file="${lib.dir}" />
		<!-- <delete dir="reg-lib" /> -->
		<mkdir dir="${dirPro}" />
	</target>

	<target name="copy-deps" depends="lib-resolve,clean-plugin-lib" description="retrieve only resolved runtime jars (no cache copy)">

		<!-- Get the resolved jars as a fileset -->
	    <ivy:cachefileset setid="runtime.jars" conf="${ivy.conf}" type="jar"/>

	    <!-- Filter that fileset by filename (because refid filesets can't have nested excludes) -->
	    <restrict id="runtime.filtered">
	        <fileset refid="runtime.jars"/>
	        <not>
	        	<or>
					<!-- sources / javadoc / tests -->
					<name name="**/*-sources.jar"/>
					<name name="**/*-source.jar"/>
					<name name="**/*-src.jar"/>
					<name name="**/*-javadoc.jar"/>
					<name name="**/*-tests.jar"/>
					<name name="**/*-test.jar"/>
					<name name="**/*javadoc*.jar"/>
					<name name="**/*sources*.jar"/>

					<!-- already-removed server/runtime baggage -->
					<name name="**/jetty-*.jar"/>
					<name name="**/netty-*.jar"/>
					<name name="**/mockserver-*.jar"/>
					<name name="**/zookeeper*.jar"/>
					<name name="**/sshd-*.jar"/>
					<name name="**/swagger-*.jar"/>
					<name name="**/json-path-*.jar"/>
					<name name="**/json-schema-*.jar"/>
					<name name="**/velocity-*.jar"/>
					<name name="**/jline-*.jar"/>

					<!-- test / instrumentation leftovers -->
					<name name="**/byte-buddy-*.jar"/>
					<name name="**/byte-buddy-agent-*.jar"/>
					<name name="**/cglib-nodep-*.jar"/>
					<name name="**/jmock-*.jar"/>
					<name name="**/jol-core-*.jar"/>
					<name name="**/mockwebserver-*.jar"/>
					<name name="**/micronaut-test-type-pollution-*.jar"/>
					<name name="**/freehep-graphicsio-tests-*.jar"/>
					<name name="**/junit-platform-suite-*.jar"/>

					<!-- optional Hadoop/auth removal -->
					<name name="**/hadoop-*.jar"/>
					<name name="**/lzo-hadoop-*.jar"/>
					<name name="**/kerb-*.jar"/>
					<name name="**/kerby-*.jar"/>

					<!-- optional old web-service baggage -->
					<name name="**/javax.servlet-api-*.jar"/>
					<name name="**/jsp-api-*.jar"/>
					<name name="**/jaxws-rt-*.jar"/>
					<name name="**/jaxb-impl-*.jar"/>
					<name name="**/javax.mail-*.jar"/>
					<name name="**/activation-*.jar"/>
					<name name="**/stax-*.jar"/>
					<name name="**/jersey-*.jar"/>
					<name name="**/wildfly-openssl-*.jar"/>
					<name name="**/wildfly-openssl-java-*.jar"/>

					<!-- Kotlin mismatch guard -->
					<name name="**/kotlin-stdlib-1.6.0.jar"/>
				</or>
	        </not>
	    </restrict>

	    <!-- Copy only the filtered resources -->
	    <copy todir="${plugin.lib.dir}" overwrite="false" flatten="true">
	        <resources refid="runtime.filtered"/>
	    </copy>

	</target>
	
	<target name="clean-plugin-lib">
		<delete includeemptydirs="true">
			<fileset dir="${plugin.lib.dir}" includes="**/*.jar"/>
		</delete>
	</target>
	
	
	<target name="update-bundle-classpath">

		<path id="runtime.libs">
	        <fileset dir="lib" includes="**/*.jar">

	            <!-- exclude sources/javadoc/test jars -->
	            <exclude name="**/*-sources.jar"/>
	            <exclude name="**/*-source.jar"/>
	            <exclude name="**/*-src.jar"/>
	            
	            <!-- Java XML APIs are provided by the JDK module java.xml -->
				<exclude name="**/xml-apis-*.jar"/>
				<exclude name="**/xmlParserAPIs-*.jar"/>
				<exclude name="**/jaxp-api-*.jar"/>

	            <exclude name="**/*-javadoc.jar"/>

	            <exclude name="**/*-tests.jar"/>
	            <exclude name="**/*-test.jar"/>

	            <exclude name="**/*javadoc*.jar"/>
	            <exclude name="**/*sources*.jar"/>

	        </fileset>
	    </path>

	    <pathconvert
	        property="bundle.classpath.libs"
	        refid="runtime.libs"
	        pathsep=",">

	        <mapper>
	            <chainedmapper>
	                <flattenmapper/>
	                <globmapper from="*" to="lib/*"/>
	            </chainedmapper>
	        </mapper>

	    </pathconvert>

		<property
	        name="bundle.classpath"
	        value="org.pm4knime.java.jar,${bundle.classpath.libs}"/>

	    <echo message="Bundle-ClassPath will be: ${bundle.classpath}"/>

	    <manifest file="META-INF/MANIFEST.MF" mode="update">
	        <attribute name="Bundle-ClassPath" value="${bundle.classpath}"/>
	    </manifest>

	</target>
	
	
	<target name="strip-embedded-js" depends="copy-deps"
		description="REBUILD ProM jars without vulnerable embedded JS">

		    <strip-jar jarIncludes="BasicUtils-latest.jar"               excludes="jquery/**"/>
		    <strip-jar jarIncludes="DirectlyFollowsModelMiner-latest.jar" excludes="jquery/**"/>
		    <strip-jar jarIncludes="InductiveMiner-latest.jar"           excludes="jquery/**"/>	
			<strip-jar jarIncludes="EfficientStorage-latest.jar"         excludes="jquery/**"/>
		    <strip-jar jarIncludes="ExtendedHybridMiner-latest.jar"      excludes="jquery/**"/>
		    <strip-jar jarIncludes="InductiveMinerDeprecated-latest.jar" excludes="jquery/**"/>
		    <strip-jar jarIncludes="InductiveVisualMiner-latest.jar"     excludes="jquery/**"/>
		    <strip-jar jarIncludes="Log-latest.jar"                      excludes="jquery/**"/>
		    <strip-jar jarIncludes="LogDialog-latest.jar"                excludes="jquery/**"/>
		    <strip-jar jarIncludes="LogProjection-latest.jar"            excludes="jquery/**"/>
		    <strip-jar jarIncludes="Murata-latest.jar"                   excludes="jquery/**"/>
		    <strip-jar jarIncludes="PNAnalysis-latest.jar"               excludes="jquery/**"/>
		    <strip-jar jarIncludes="PetriNets-latest.jar"                excludes="jquery/**"/>
		    <strip-jar jarIncludes="ProM-Contexts-latest.jar"            excludes="jquery/**"/>
		    <strip-jar jarIncludes="ProM-Framework-latest.jar"           excludes="jquery/**"/>
		    <strip-jar jarIncludes="ProM-Models-latest.jar"              excludes="jquery/**"/>
		    <strip-jar jarIncludes="ProM-Plugins-latest.jar"             excludes="jquery/**"/>
		    <strip-jar jarIncludes="TransitionSystems-latest.jar"        excludes="jquery/**"/>
		    <strip-jar jarIncludes="Widgets-latest.jar"                  excludes="jquery/**"/>
		

		</target>

	<target name="frontend-npm-ci" if="frontend.has.lock" description="npm ci for ui-extension frontends">
		<exec executable="${npm.exec}" dir="${frontend.dir}" failonerror="true">
			<arg value="ci"/>
		</exec>
	</target>

	<target name="frontend-npm-install" unless="frontend.has.lock" description="npm install for ui-extension frontends">
		<exec executable="${npm.exec}" dir="${frontend.dir}" failonerror="true">
			<arg value="install"/>
		</exec>
	</target>

	<target name="build-frontend" depends="frontend-npm-ci,frontend-npm-install" description="build ui-extension frontends">
		<exec executable="${npm.exec}" dir="${frontend.dir}" failonerror="true">
			<arg value="run"/>
			<arg value="build"/>
		</exec>
	</target>

	
	<target name="main" depends="set,lib-resolve,clean-plugin-lib,copy-deps,strip-embedded-js,update-bundle-classpath,build-frontend"/>
</project>
